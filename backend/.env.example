NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173,https://your-frontend.vercel.app

# Use a local MongoDB URI for development; set your private Atlas URI in Vercel.
MONGODB_URI=mongodb://127.0.0.1:27017/hcm_lite
# Optional; when set, this must match the database name in MONGODB_URI.
MONGODB_DATABASE=
# Optional; used only by backend persistence tests.
MONGODB_TEST_URI=

# Generate different high-entropy secrets; do not use these sample values.
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# Generate 32 random bytes and encode them as 64 hexadecimal characters.
FACE_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS_FROM_32_RANDOM_BYTES
FACE_MATCH_THRESHOLD=0.48

# Optional AI integration.
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=30000
